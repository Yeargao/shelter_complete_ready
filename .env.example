# Export on the FastAPI host. The Python service reads environment variables.
SHELTER_DB_PATH=
SHELTER_MODEL_MODE=demo
SHELTER_AUTH_SECRET=
SHELTER_AUTH_PASSWORDS=
SHELTER_CORS_ORIGINS=
SHELTER_SOLVER_PHASE_SECONDS=6
# Server only. Use an API key from an AI Studio Free Tier project.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_ENABLED=0
# Enable only for demo data or data authorized for external processing.
LLM_DATA_APPROVED=0
# Conservative local defaults, not Google quota guarantees. Verify against AI Studio.
# Explicit zero disables external calls.
LLM_MAX_REQUESTS_PER_MINUTE=5
LLM_MAX_REQUESTS_PER_DAY=20
LLM_MAX_INPUT_TOKENS_PER_MINUTE=20000
LLM_MAX_OUTPUT_TOKENS=512
LLM_CHAT_RESERVED_REQUESTS=0
LLM_CACHE_TTL_SECONDS=86400
SHELTER_UPLOAD_DIR=
SHELTER_REQUIRE_OBJECT_STORAGE=0
SHELTER_PHOTO_BUCKET=
SHELTER_PHOTO_ENDPOINT=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Set on the Vite build. Default API base is the same origin.
VITE_API_URL=
VITE_SHELTER_DEMO=true

# Optional AI tools: explicit authorization for sending free-text notes to Gemini.
SHELTER_AI_NOTES_APPROVED=0
# Optional local CLIP model directory (no runtime download). Leave unset on memory-limited hosts.
SHELTER_CLIP_MODEL_DIR=
